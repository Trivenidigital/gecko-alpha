# gecko job runner: one oneshot instance per job, started by deploy/gecko/timers/.
# `systemctl start gecko-job@<job>.service` runs `python -m gecko <job>` once.
# A timer cannot start an instance that is still active, so a job never overlaps itself.
[Unit]
Description=gecko job %i
After=network-online.target
Wants=network-online.target
OnFailure=codex-systemd-failure-alert@%n.service

[Service]
Type=oneshot
WorkingDirectory=/root/gecko-alpha
EnvironmentFile=/root/gecko-alpha/.env.gecko
# Explicit and absolute: the legacy gecko-backup.service exports a GECKO_DB_PATH
# that means scout.db. NOTE: systemd lets EnvironmentFile= values override
# Environment=, so .env.gecko must carry this same value or none (runbook preflight).
Environment=GECKO_DB_PATH=/root/gecko-alpha/gecko.db
Environment=PATH=/root/.local/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=/root/.local/bin/uv run --frozen python -m gecko %i
Nice=5
TimeoutStartSec=900
