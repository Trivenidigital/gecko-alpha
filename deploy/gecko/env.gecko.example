# /root/gecko-alpha/.env.gecko — gecko settings (GeckoSettings, prefix GECKO_).
# Mode 0600, root-owned, never committed. NEVER put GECKO_* keys in the legacy
# /root/gecko-alpha/.env: the frozen scout settings use extra="forbid" and crash-loop.
# Stage 1 of docs/runbook_gecko_activation.md creates the real file and copies the
# secrets from the legacy .env without echoing them. Secrets stay blank in this example
# AND commented out: a present-but-empty secret parses as an empty SecretStr, not
# None, and passes the `is None` guards (e.g. the coingecko keyless refusal).
# Write a secret line only when it has a value.
# Every gecko unit reads this ONE file (timers and the reader share it).

# --- database --------------------------------------------------------------
# Absolute. The units also set it explicitly, but systemd lets EnvironmentFile=
# values override Environment=, so this line must be exactly this path or absent.
GECKO_DB_PATH=/root/gecko-alpha/gecko.db
# Rows in observations older than this are pruned daily (floor 30). 60 d during
# coexistence for disk headroom (system review §3.3).
GECKO_OBS_RETENTION_DAYS=60
# runs rows kept this long (floor 35: the CoinGecko monthly budget sums back to the 1st).
GECKO_RUNS_RETENTION_DAYS=90
# journald output: json | console
GECKO_LOG_FORMAT=json

# --- universe and admission -------------------------------------------------
# JSON values go in SINGLE quotes: systemd's EnvironmentFile= and python-dotenv then
# both pass the inner double quotes through literally.
# JSON list; supported: solana, base, ethereum, bsc
GECKO_CHAINS='["solana","base","ethereum","bsc"]'
GECKO_MIN_LIQUIDITY_USD=250000
GECKO_MIN_MCAP_USD=500000
GECKO_MAX_MCAP_USD=200000000
# hours a candidate must survive before admission
GECKO_SURVIVOR_HOURS=24
GECKO_CANDIDATE_MAX_AGE_DAYS=14
GECKO_DEAD_AFTER_DAYS=7
# chain -> ISO launch date for young chains (JSON object); empty = none
GECKO_YOUNG_CHAIN_LAUNCH_DATES='{}'

# --- ranking and watchlist ---------------------------------------------------
GECKO_WATCHLIST_CAP=50
GECKO_WATCHLIST_MAX_AGE_DAYS=180
GECKO_F4_MAX_AGE_DAYS=90
GECKO_F4_MIN_VOL_RATIO=2.0
GECKO_TOP10_DISQUALIFY_PCT=60.0
# false until every active token has >= 1 known enrich verdict (runbook flip criterion)
GECKO_REQUIRE_SECURITY_KNOWN=false

# --- ledger -----------------------------------------------------------------
# open rows this long past due are closed unmeasured (irreversible; floor 7)
GECKO_LEDGER_MAX_OVERDUE_DAYS=14

# --- HTTP and rate limits ------------------------------------------------------
GECKO_HTTP_TIMEOUT_SEC=20
# GeckoTerminal: 6.0 s spacing and 50 OHLCV pools per run while the legacy
# pipeline still shares this IP (it already draws 429s; system review §1.3).
GECKO_GT_MIN_INTERVAL_SEC=6.0
GECKO_OHLCV_MAX_PER_RUN=50
GECKO_DS_MIN_INTERVAL_SEC=0.25
GECKO_DS_REFRESH_MAX_PER_RUN=600

# --- CoinGecko (Demo tier) ----------------------------------------------------
# OWNER-PROVIDED: a free CoinGecko Demo key (the old Pro key is deactivated).
# Until it exists the coingecko-* timers stay disabled (install.sh --with-coingecko).
# GECKO_COINGECKO_DEMO_API_KEY=
GECKO_COINGECKO_MONTHLY_CAP=8000
GECKO_CG_MIN_INTERVAL_SEC=2.1
GECKO_CG_FIRST_PAGE=2
GECKO_CG_MAX_PAGES=14
GECKO_CG_HOURLY_RESERVE=100
GECKO_CG_MAX_LOOKUPS_PER_RUN=300

# --- GoPlus enrich (keyless) --------------------------------------------------
GECKO_GP_MIN_INTERVAL_SEC=2.0
GECKO_GP_MAX_PER_RUN=40
GECKO_GP_DAILY_CAP=1000
GECKO_GP_REFRESH_HOURS=20

# --- Telegram reader (Telethon, gecko's OWN session) ---------------------------
# Copied from the legacy TG_SOCIAL_API_ID / TG_SOCIAL_API_HASH by stage 1.
GECKO_TG_API_ID=0
# GECKO_TG_API_HASH=
# absolute, outside the repo, mode 0600; written by `python -m gecko tg-login` (OWNER)
GECKO_TG_SESSION_PATH=/root/.gecko/gecko_tg.session
# Set ONLY after tg-login, in the same step as `systemctl enable --now
# gecko-telegram-reader.service`: the reader exits 2 without it, and set without a
# running reader freshness pages source_calls within 30 min. tg-login does not
# need it. JSON list of public handles in single quotes, e.g.
# GECKO_TG_CHANNELS='["@foo","@bar"]' (migrate-calls prints the legacy list).
GECKO_TG_SEED_MAX=60
GECKO_TG_POLL_INTERVAL_SEC=120
GECKO_TG_CATCHUP_LIMIT=200

# --- alerts and digest ----------------------------------------------------------
# Copied from the legacy TELEGRAM_BOT_TOKEN / TELEGRAM_HEALTH_CHAT_ID / TELEGRAM_CHAT_ID.
# GECKO_TELEGRAM_BOT_TOKEN=
# Commented out like the secrets: an empty chat id parses as '' and alerts go to chat ''.
# GECKO_TELEGRAM_HEALTH_CHAT_ID=
# GECKO_TELEGRAM_DIGEST_CHAT_ID=
GECKO_DIGEST_TOP_N=10
GECKO_SCORECARD_MIN_N=20

# --- research (LLM dossiers into research_notes only) ---------------------------
# Copied from the legacy ANTHROPIC_API_KEY; blank = research disabled.
# GECKO_ANTHROPIC_API_KEY=
GECKO_ANTHROPIC_BASE_URL=https://api.anthropic.com
GECKO_RESEARCH_MODEL=claude-sonnet-5-5
GECKO_RESEARCH_MAX_PER_RUN=10
GECKO_RESEARCH_DAILY_USD_CAP=1.5
GECKO_RESEARCH_MAX_SEARCHES=5
GECKO_RESEARCH_USD_PER_MTOK_IN=2.0
GECKO_RESEARCH_USD_PER_MTOK_OUT=10.0
GECKO_RESEARCH_USD_PER_SEARCH=0.01
GECKO_RESEARCH_MAX_TOKENS=2000
