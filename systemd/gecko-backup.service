[Unit]
Description=Gecko-Alpha — create scout.db online backup + rotate to keep top-N

[Service]
Type=oneshot
User=root
Group=root
StateDirectory=gecko-alpha
StateDirectoryMode=0750
Environment=GECKO_DB_PATH=/root/gecko-alpha/scout.db
Environment=GECKO_BACKUP_DIR=/root/gecko-alpha
Environment=GECKO_BACKUP_KEEP=3
Environment=GECKO_BACKUP_HEARTBEAT_FILE=/var/lib/gecko-alpha/backup-rotation/backup-last-ok
Environment=GECKO_BACKUP_CREATE_HEARTBEAT_FILE=/var/lib/gecko-alpha/backup-rotation/create-last-ok
ExecStartPre=/usr/bin/test -x /usr/local/bin/gecko-backup-create.sh
ExecStartPre=/usr/bin/test -x /usr/local/bin/gecko-backup-rotate.sh
# Round 11 — chained: create produces a fresh online backup
# (sqlite3 .backup, lock-free against concurrent writers) AND verifies
# integrity. Rotate then prunes to keep-N. Prior config ran only the
# rotation step against a producer that never existed (found=0 every
# day for weeks before discovery).
ExecStart=/usr/local/bin/gecko-backup-create.sh
ExecStart=/usr/local/bin/gecko-backup-rotate.sh
# Sizing, corrected 2026-08-08 against measurement rather than estimate.
#
# The previous value was derived from an estimate of a few minutes for a 5 GB
# database plus a short integrity check, treated as generous headroom. That
# assumption is empirically false at the current size: on 2026-08-08 with
# scout.db at 6.82 GB, the
# `.backup` phase alone was still running when systemd terminated the unit at
# exactly 600s, having written 6.82 GB (99.98% of source).
#
# Note what that observation does NOT establish: it measures the `.backup`
# phase only, up to termination. It says nothing about how long the subsequent
# full `PRAGMA integrity_check` takes on a ~6.8 GB database, and "99.98% of
# bytes written" is not proof the copy was seconds from done — the source is
# being written concurrently by the live pipeline.
#
# 1800s is therefore chosen for headroom over an unmeasured phase, not as a
# tight fit to a known duration. It still bounds a hung job at 30 minutes
# instead of removing the bound.
#
# A too-small value here is not merely a failed backup: systemd sends SIGTERM,
# and before the signal trap in gecko-backup-create.sh that left a full-size
# orphan `.partial` (6.8 GB on 2026-08-08) which no later run ever cleaned.
TimeoutStartSec=1800
StandardOutput=journal
StandardError=journal
