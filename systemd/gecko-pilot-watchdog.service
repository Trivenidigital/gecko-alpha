[Unit]
Description=Gecko-Alpha — pilot threshold watchdog (read-only observer)
Documentation=file:///root/gecko-alpha/tasks/plan_losers_contrarian_bounded_pilot_2026_08_08.md
After=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/root/gecko-alpha
Environment=GECKO_PILOT_WATCHDOG_ENABLED=false
# Read-only observer. It opens scout.db `mode=ro` and never calls
# Database.initialize() — a read-only consumer entering the migration
# machinery is the exact failure class removed in PR #520, where the Solana
# cron watchdog ran ~40 migrations against a live 6.8 GB database every two
# minutes and produced 74 `database is locked` failures.
#
# Deploy-without-activate: ships disabled. Activation is a single .env / unit
# override flip, so the code can land and be verified before it can page.
ExecStart=/root/.local/bin/uv run python scripts/pilot_threshold_watchdog.py \
    --db /root/gecko-alpha/scout.db \
    --enabled ${GECKO_PILOT_WATCHDOG_ENABLED} \
    --state-dir /var/lib/gecko-alpha/pilot-watchdog
# 5 = one or more triggers fired. That is a normal, expected outcome for an
# observer, not a unit failure — mapping it to success keeps `systemctl status`
# meaningful for REAL faults (exit 1: DB missing, dispatch failure).
SuccessExitStatus=0 5
TimeoutStartSec=120

[Install]
WantedBy=multi-user.target
