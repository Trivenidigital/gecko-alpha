[Unit]
Description=Legacy chains-provenance overlay coverage watchdog
After=network-online.target

[Service]
Type=oneshot
# Exit 1 is the ALARM path and has already sent Telegram, so it is not a
# service failure. 2-7 are failures OF THE WATCHDOG and must surface in
# systemctl status, because nothing else reports them.
SuccessExitStatus=0 1
# Runs the REPO copy, not an installed one. Installing the .sh to
# /usr/local/bin while it invokes the .py from the repo splits the watchdog in
# half: the python side updates on `git pull`, the shell side needs a re-install
# and silently does not deploy. That exact trap is already in this project's
# history with the backup scripts. Pointing systemd at the repo keeps both
# halves on one deploy path.
WorkingDirectory=/root/gecko-alpha
# Preflight, matching chain-anchor-health and minara-emission-persistence.
# The script ships 100755 so this should never fire -- but the two guarantees
# are different: the mode bit PREVENTS a permission failure, this makes one
# LOUD if it happens anyway (a bad deploy, a chmod, a filesystem restore). Two
# of the four sibling units already had it and this one did not, which is the
# gap that turns "the watchdog never ran" into a silent condition rather than a
# unit failure -- the exact outcome this unit exists to report on.
ExecStartPre=/usr/bin/test -x /root/gecko-alpha/scripts/recompute-coverage-watchdog.sh
ExecStart=/root/gecko-alpha/scripts/recompute-coverage-watchdog.sh
